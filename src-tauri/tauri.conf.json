{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "viaComponentis",
  "version": "0.1.0",
  "identifier": "com.projectgloria.viacomponentis",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "viaComponentis — React Roadmap OS",
        "width": 1240,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": false,
        "resizable": true,
        "center": true,
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
